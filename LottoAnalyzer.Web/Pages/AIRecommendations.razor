@page "/ai-recommendations"

<PageTitle>특별추천 - 로또 분석기</PageTitle>

<!-- 최근 당첨번호 (Sticky) -->
@if (LatestResult != null)
{
    <div class="sticky-latest-result">
        <div class="container" style="display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap;">
            <span style="color: #ff6b35; font-weight: bold; font-size: 13px;">@(LatestResult.Round)회</span>
            @foreach (var num in LatestResult.Numbers)
            {
                <LottoBall Number="@num" Small="true" />
            }
            <span style="color: #666; font-size: 14px;">+</span>
            <LottoBall Number="@LatestResult.BonusNumber" Small="true" />
        </div>
    </div>
}

<div class="container">
    <h1 style="margin-bottom: 10px;">특별추천</h1>
    <p style="color: #666; margin-bottom: 15px;">
        7년치 데이터의 동반 출현 분석 기반 추천 + 번호별 +-1~2 변형 조합
    </p>
    <div style="background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%); color: #fff; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; text-align: center;">
        사용은 누구나 무료! 대신 당첨되면 1/3 주인장한테 나눠주면 됩니다 😉
    </div>

    <div style="margin-bottom: 20px;">
        <button class="btn btn-primary" @onclick="Generate" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
            @if (IsLoading)
            {
                <span>분석 중...</span>
            }
            else
            {
                <span>특별추천 생성</span>
            }
        </button>
    </div>

    @if (BaseNumbers.Length > 0)
    {
        <!-- 기본 동반출현 추천 -->
        <div class="card" style="margin-bottom: 20px; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border: 1px solid #333;">
            <div style="color: #fff; font-weight: bold; margin-bottom: 8px; font-size: 16px;">
                동반 출현 추천 (7년치 @(DataCount)회 기반)
            </div>
            <div style="color: #aaa; font-size: 13px; margin-bottom: 12px;">
                함께 자주 당첨되는 번호 조합 (트리플 + 페어 분석)
            </div>
            <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 8px;">
                @foreach (var num in BaseNumbers)
                {
                    <LottoBall Number="@num" />
                }
            </div>
            <div style="color: #888; font-size: 11px; margin-top: 8px;">
                이 번호를 기준으로 아래 변형 조합이 생성됩니다
            </div>
        </div>

        <!-- 변형 조합들 -->
        <div style="margin-bottom: 15px; color: #666;">
            <strong>변형 조합 (각 번호 +-1~2 범위)</strong>
        </div>

        @for (int i = 0; i < Variations.Count; i++)
        {
            var variation = Variations[i];
            var idx = i;
            <div class="card" style="margin-bottom: 12px; border-left: 4px solid @GetVariationColor(idx);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="font-weight: bold; font-size: 14px; color: @GetVariationColor(idx);">
                        변형 @(idx + 1)
                    </span>
                    <span style="font-size: 12px; color: #999;">
                        합계 @(variation.Numbers.Sum())
                    </span>
                </div>

                <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 8px;">
                    @for (int j = 0; j < variation.Numbers.Length; j++)
                    {
                        var num = variation.Numbers[j];
                        var baseNum = BaseNumbers[j];
                        var diff = num - baseNum;
                        <div style="text-align: center;">
                            <LottoBall Number="@num" />
                            @if (diff != 0)
                            {
                                <div style="font-size: 10px; color: @(diff > 0 ? "#4CAF50" : "#f44336"); margin-top: 2px;">
                                    @(diff > 0 ? $"+{diff}" : $"{diff}")
                                </div>
                            }
                            else
                            {
                                <div style="font-size: 10px; color: #999; margin-top: 2px;">원본</div>
                            }
                        </div>
                    }
                </div>

                <div style="font-size: 11px; color: #bbb;">
                    @variation.Description
                </div>
            </div>
        }

        <div class="card" style="margin-top: 15px; background: #fff3e0; border: 1px solid #ffe0b2;">
            <p style="margin: 0; color: #e65100; font-size: 13px;">
                <strong>주의:</strong> 이 추천은 과거 통계 분석에 기반하며, 당첨을 보장하지 않습니다.
                로또는 무작위 추첨이므로 어떤 전략도 확실한 우위를 제공하지 않습니다.
            </p>
        </div>
    }
    else
    {
        <div class="card" style="text-align: center; padding: 40px;">
            <p style="color: #666;">버튼을 클릭하여 특별추천 번호를 생성하세요.</p>
        </div>
    }
</div>

@code {
    [Inject] public LottoDataService DataService { get; set; } = default!;
    [Inject] public StatisticsService StatisticsService { get; set; } = default!;
    [Inject] public RecommendationService RecommendationService { get; set; } = default!;

    private bool IsLoading = false;
    private int[] BaseNumbers = Array.Empty<int>();
    private List<VariationSet> Variations = new();
    private int DataCount = 0;
    private LottoResult? LatestResult;
    private Random _random = new();

    protected override void OnInitialized()
    {
        try
        {
            var results = DataService.GetSampleData();
            LatestResult = results.OrderByDescending(r => r.Round).FirstOrDefault();
        }
        catch { }
    }

    private void Generate()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            // 7년치 데이터로 동반출현 추천 생성
            var results7y = DataService.GetSampleData(7);
            DataCount = results7y.Count;
            var allRecs = RecommendationService.GenerateRecommendations(results7y);
            var pairRec = allRecs.FirstOrDefault(r => r.RecommendationType.Contains("동반"));
            if (pairRec != null)
            {
                BaseNumbers = pairRec.Numbers;
            }
            else
            {
                BaseNumbers = allRecs.First().Numbers;
            }

            // 변형 조합 생성
            Variations = GenerateVariations(BaseNumbers);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<VariationSet> GenerateVariations(int[] baseNums)
    {
        var list = new List<VariationSet>();
        var offsets = new[]
        {
            (new[] { +1, -1, +1, -1, +1, -1 }, "홀수위치 +1, 짝수위치 -1"),
            (new[] { -1, +1, -1, +1, -1, +1 }, "홀수위치 -1, 짝수위치 +1"),
            (new[] { +2, +1, 0, 0, -1, -2 }, "앞쪽 상향, 뒤쪽 하향"),
            (new[] { -2, -1, 0, 0, +1, +2 }, "앞쪽 하향, 뒤쪽 상향"),
            (new[] { +1, +1, +1, +1, +1, +1 }, "전체 +1"),
            (new[] { -1, -1, -1, -1, -1, -1 }, "전체 -1"),
            (new[] { +2, 0, +2, 0, +2, 0 }, "홀수위치 +2, 짝수위치 원본"),
            (new[] { 0, -2, 0, -2, 0, -2 }, "홀수위치 원본, 짝수위치 -2"),
        };

        foreach (var (offset, desc) in offsets)
        {
            var nums = new int[6];
            bool valid = true;
            var usedSet = new HashSet<int>();

            for (int i = 0; i < 6; i++)
            {
                int n = baseNums[i] + offset[i];
                n = Math.Clamp(n, 1, 45);
                // 중복 방지
                while (usedSet.Contains(n))
                {
                    n += (offset[i] >= 0) ? 1 : -1;
                    n = Math.Clamp(n, 1, 45);
                }
                if (usedSet.Contains(n)) { valid = false; break; }
                usedSet.Add(n);
                nums[i] = n;
            }

            if (valid)
            {
                Array.Sort(nums);
                list.Add(new VariationSet { Numbers = nums, Description = desc });
            }
        }

        // 랜덤 변형 2개 추가
        for (int v = 0; v < 2; v++)
        {
            var nums = new int[6];
            var usedSet = new HashSet<int>();
            var offsetDesc = new List<string>();

            for (int i = 0; i < 6; i++)
            {
                int off = _random.Next(-2, 3); // -2 ~ +2
                int n = baseNums[i] + off;
                n = Math.Clamp(n, 1, 45);
                while (usedSet.Contains(n))
                {
                    n += (off >= 0) ? 1 : -1;
                    n = Math.Clamp(n, 1, 45);
                }
                usedSet.Add(n);
                nums[i] = n;
            }

            Array.Sort(nums);
            list.Add(new VariationSet { Numbers = nums, Description = $"랜덤 변형 {v + 1}" });
        }

        return list;
    }

    private string GetVariationColor(int index)
    {
        var colors = new[] { "#4CAF50", "#2196F3", "#ff9800", "#9C27B0", "#00BCD4", "#E91E63", "#607D8B", "#795548", "#3F51B5", "#FF5722" };
        return colors[index % colors.Length];
    }

    private class VariationSet
    {
        public int[] Numbers { get; set; } = Array.Empty<int>();
        public string Description { get; set; } = "";
    }
}
